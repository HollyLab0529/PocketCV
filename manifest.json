{
  "manifest_version": 3,
  "name": "口袋简历 PocketCV",
  "version": "0.5.9",
  "version_name": "0.5.2",
  "minimum_chrome_version": "116",
  "description": "把求职资料装进口袋：侧栏管理个人信息与经历，在招聘网页逐项填写。本地存储、可加密备份、Excel 模板可交给任意 AI 填写，插件内还可按 JD 定制。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.moonshot.cn/*",
    "https://api.siliconflow.cn/*",
    "https://api.openai.com/*"
  ],
  "action": {
    "default_title": "打开口袋简历 · 连接当前页面",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "manager.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "打开口袋简历并连接当前网页"
    }
  }
}